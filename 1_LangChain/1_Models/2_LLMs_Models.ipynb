    "\n",
    "llm = OpenAI(\n",
    "    model = \"gpt-3.5-turbo-instruct\"\n",
    ")\n",
    "\n",
    "result = llm.invoke(\"What is the capital of India\")\n",
    "\n",
    "print(result)"
